# Run `sh scripts/setup.sh` to generate a private .env with a random admin password.
# If creating .env manually, set a unique password of at least 12 characters.
PORTPILOT_ADMIN_PASSWORD=
PORTPILOT_LISTEN=0.0.0.0:8787

# These values ONLY seed a new installation. Use the UI to change existing data.
PORTPILOT_PUBLIC_HOST=127.0.0.1
PORTPILOT_CONTROLLER_URL=http://127.0.0.1:9090
# Leave blank to use username portpilot and an automatically generated password.
PORTPILOT_PROXY_USERNAME=
PORTPILOT_PROXY_PASSWORD=

# Pin a tested Mihomo release. Core upgrades are independent of panel upgrades.
MIHOMO_IMAGE=metacubex/mihomo:v1.19.32
# Default builds locally. Released images use ghcr.io/maodeyu180/portpilot.
PORTPILOT_IMAGE_REPOSITORY=portpilot
PORTPILOT_IMAGE_TAG=local
# Optional build-only Go module proxy; checksum verification stays enabled.
PORTPILOT_GOPROXY=https://proxy.golang.org,direct
